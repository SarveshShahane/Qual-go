# ==============================================================================
# QUALGO Backend - Environment Configuration Template
# Copy this file to .env and customize for your local or production deployment
# ==============================================================================

# Database Connection (Individual fields or unified DATABASE_URL)
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_password
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=postgres
# DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password@localhost:5432/postgres

# Application Environment (development, test, production)
ENVIRONMENT=development

# JWT & Authentication Security
JWT_SECRET_KEY=super-secret-jwt-key-qual-dev-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false

# AI Tutor LLM Service (Groq API)
GROQ_API_KEY=your_groq_api_key_here
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# Cross-Origin Resource Sharing (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://127.0.0.1:5173

# Container Startup Controls
RUN_MIGRATIONS=true
RUN_SEED=false
